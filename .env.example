# =====================================================================
# Face Attendance System — example environment variables
# Copy this file to `.env` (root or per-app) and fill in real values.
# NEVER commit `.env` or any file containing real secrets.
# =====================================================================

# ---- Web application (Next.js) --------------------------------------
# Public URL of this web app (used for OAuth callbacks).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# MongoDB Atlas connection string used by the web app.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/face_attendance?retryWrites=true&w=majority"

# Better Auth core secret. Generate with: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth credentials (create at https://console.cloud.google.com/)
GOOGLE_CLIENT_ID="google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="google-oauth-client-secret"

# Internal Face Service endpoint and shared secret for service-to-service auth.
# The secret MUST match the FACE_SERVICE_SECRET configured in services/face-service.
FACE_SERVICE_URL="http://localhost:8001"
FACE_SERVICE_SECRET="replace-with-a-long-random-shared-secret"

# ---- Face Service (Python / FastAPI) -------------------------------
# Shared secret the web app sends in `X-Service-Token`.
# MUST match FACE_SERVICE_SECRET above. Never expose to the browser.
FACE_SERVICE_SECRET="replace-with-a-long-random-shared-secret"

# Model to load on startup. Default for development: buffalo_l.
# Operators MUST verify the model license before commercial deployment.
# See docs/model-license.md.
FACE_MODEL_NAME="buffalo_l"

# Optional: force CPU or CUDA execution.
# Allowed values: cpu | cuda. Leave unset to auto-detect.
FACE_EXECUTION_PROVIDER="cpu"

# Bind host / port.
FACE_SERVICE_HOST="127.0.0.1"
FACE_SERVICE_PORT="8001"