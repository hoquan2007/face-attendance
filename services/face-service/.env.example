# Face Service environment variables (copy to .env and fill in).
# NEVER commit `.env` or any file containing real secrets.

# Shared service-to-service secret. MUST match FACE_SERVICE_SECRET in apps/web.
# Never expose this value to the browser.
FACE_SERVICE_SECRET="replace-with-a-long-random-shared-secret"

# Model configuration (used from Phase 3 onward).
FACE_MODEL_NAME="buffalo_l"
FACE_EXECUTION_PROVIDER="cpu"  # cpu | cuda (CUDA support added in Phase 3)

# Bind address.
FACE_SERVICE_HOST="127.0.0.1"
FACE_SERVICE_PORT="8001"