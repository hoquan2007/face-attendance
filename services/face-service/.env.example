# Face Service environment variables (copy to .env and fill in).
# NEVER commit `.env` or any file containing real secrets.

# Service-to-service shared secret. MUST match FACE_SERVICE_SECRET in apps/web.
# Required for Phase 3: all /v1/* endpoints reject requests without this header.
# Never expose this value to the browser.
FACE_SERVICE_SECRET="replace-with-a-long-random-shared-secret"

# --- Model configuration (Phase 3+) ---
# Official InsightFace model pack name. buffalo_l = SCRFD-10GF + ResNet50/WebFace600K
# (ArcFace R50, 512-d). Note: model weights are non-commercial-research only; see
# docs/model-license.md before any production deployment.
FACE_MODEL_NAME="buffalo_l"

# Execution provider. Phase 3 only supports "cpu" — CUDA support arrives in a later phase.
FACE_EXECUTION_PROVIDER="cpu"

# Optional InsightFace model cache root (default: ~/.insightface).
# Override to keep the cache inside the project for reproducible dev setups.
# INSIGHTFACE_HOME=""

# --- Detection tuning ---
# SCRFD detection confidence threshold (0.0–1.0). Faces below this are discarded.
FACE_DET_THRESHOLD="0.5"

# Detection size. "auto" runs SCRFD at both 128x128 and 640x640 (InsightFace 1.0 default).
# Use "WxH" (e.g. "640x640") to force a single resolution.
FACE_DET_SIZE="auto"

# --- Matcher configuration ---
# Cosine-similarity threshold above which two embeddings are considered the same person.
# THIS IS A DEVELOPMENT BASELINE — it must be re-calibrated with representative
# evaluation data before any production deployment. See docs/model-license.md.
FACE_MATCH_THRESHOLD="0.4"

# --- Image upload limits ---
# Maximum accepted upload size in megabytes.
FACE_MAX_UPLOAD_MB="8"
# Maximum accepted image width / height in pixels.
FACE_MAX_IMAGE_WIDTH="4096"
FACE_MAX_IMAGE_HEIGHT="4096"

# --- Bind address ---
FACE_SERVICE_HOST="127.0.0.1"
FACE_SERVICE_PORT="8001"

# --- Enrollment quality policy (PHASE 4.3) ---
# THESE THRESHOLDS ARE NOT PRODUCTION-CALIBRATED.
# They are conservative DEVELOPMENT BASELINES suitable for ordinary indoor
# webcam captures. They MUST be re-calibrated against a representative
# evaluation set before any production deployment. See
# docs/api.md and docs/privacy-security.md for details.

# Minimum SCRFD detection_score required for an accepted enrollment sample (0..1).
FACE_ENROLLMENT_MIN_DETECTION_SCORE="0.7"

# Minimum relative face area (face_area / image_area) for an accepted sample (0..1).
# Below this the face is too small / too far from the camera to be reliably recognized.
FACE_ENROLLMENT_MIN_FACE_AREA="0.03"

# Maximum relative face area (face_area / image_area) for an accepted sample (0..1).
# Above this the face is too close to the camera (likely a partial crop / nose cam).
FACE_ENROLLMENT_MAX_FACE_AREA="0.6"

# Minimum variance-of-Laplacian (sharpness proxy). Resolution-dependent.
# Below this the image is too blurry for enrollment.
FACE_ENROLLMENT_MIN_BLUR_SCORE="80.0"

# Minimum normalised mean luminance (0..1). Below this the image is too dark.
FACE_ENROLLMENT_MIN_BRIGHTNESS="0.18"

# Maximum normalised mean luminance (0..1). Above this the image is too bright.
FACE_ENROLLMENT_MAX_BRIGHTNESS="0.85"

# --- Enrollment finalization (PHASE 4.6A2) ---
# THIS IS A DEVELOPMENT BASELINE — NOT production-calibrated.
# Must be re-calibrated against representative evaluation data before
# any production deployment. See docs/api.md and
# docs/privacy-security.md for details.
#
# Value: 0.7 is chosen to be slightly below the ~0.75 mean-self-similarity
# observed for 5 real enrollment samples in PHASE 3 evaluation, providing
# a conservative safety margin. Must be in [-1.0, 1.0].
FACE_ENROLLMENT_MIN_SELF_SIMILARITY="0.7"
